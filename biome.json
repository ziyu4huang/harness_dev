{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "files": {
    "include": [
      "bun_apps/deepseek-cli/src/**/*.ts",
      "bun_apps/deepseek-cli/package.json",
      "bun_apps/deepseek-cli/tsconfig.json"
    ],
    "ignore": ["node_modules", "dist"]
  }
}
